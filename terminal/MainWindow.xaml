<Window x:Class="RTLTerminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RTL Terminal" Height="600" Width="800" Closing="Window_Closing">
    <DockPanel>
        <TextBox x:Name="InputBox" DockPanel.Dock="Bottom" Height="35" Padding="10,5" 
                 KeyDown="InputBox_KeyDown" Background="Black" Foreground="White" FontFamily="Consolas"/>
        <TextBox x:Name="OutputBox" DockPanel.Dock="Top" IsReadOnly="True" TextWrapping="Wrap" 
                 Background="Black" Foreground="White" FontFamily="Consolas" 
                 VerticalScrollBarVisibility="Auto" Padding="10" AcceptsReturn="True"/>
    </DockPanel>
</Window>
