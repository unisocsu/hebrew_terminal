<Window x:Class="RTLTerminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RTL Terminal" Height="600" Width="800"
        Background="#1e1e1e" Foreground="#d4d4d4"
        FontFamily="Consolas" FontSize="12"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Output area with RTL support -->
        <RichTextBox x:Name="OutputBox" 
                     Grid.Row="0"
                     Background="#1e1e1e" 
                     Foreground="#d4d4d4"
                     FontFamily="Consolas"
                     FontSize="12"
                     VerticalScrollBarVisibility="Auto"
                     AllowDrop="False"
                     IsReadOnly="True"
                     Padding="10">
            <RichTextBox.Resources>
                <Style TargetType="Paragraph">
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>
        
        <!-- Input area -->
        <Grid Grid.Row="1" Background="#252526" Height="40" Margin="0,1,0,0">
            <TextBox x:Name="InputBox"
                     Text=""
                     Background="#252526"
                     Foreground="#d4d4d4"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="10,8"
                     VerticalAlignment="Center"
                     BorderThickness="0"
                     TextWrapping="NoWrap"
                     KeyDown="InputBox_KeyDown"/>
        </Grid>
    </Grid>
</Window>
