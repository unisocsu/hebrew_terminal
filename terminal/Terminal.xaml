<Window x:Class="RTLTerminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RTL Terminal" Height="600" Width="800"
        Background="#1e1e1e" Foreground="#d4d4d4"
        FontFamily="Consolas" FontSize="12"
        Closing="Window_Closing">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="10">
            <TextBlock Text="RTL Terminal" Foreground="White" FontSize="16" Margin="0,0,0,10"/>
            <TextBlock x:Name="OutputBox" Text="Output will appear here..." Foreground="#d4d4d4" Background="#000000" Padding="5" Height="400" TextWrapping="Wrap"/>
            <TextBox x:Name="InputBox" Background="#252526" Foreground="#d4d4d4" Padding="5" Height="30" Margin="0,10,0,0" KeyDown="InputBox_KeyDown"/>
        </StackPanel>
    </Grid>
</Window>
